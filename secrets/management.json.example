{
    "Stuns": [
        {
            "Proto": "udp",
            "URI": "stun:vpn.mahamid.net:3478"
        }
    ],
    "Relay": {
        "Addresses": ["rels://vpn.mahamid.net:443"],
        "CredentialsTTL": "24h",
        "Secret": "REPLACE_WITH_RELAY_SECRET"
    },
    "Datadir": "/var/lib/netbird",
    "DataStoreEncryptionKey": "REPLACE_WITH_DATASTORE_ENCRYPTION_KEY",
    "EmbeddedIdP": {
        "Enabled": true,
        "Issuer": "https://vpn.mahamid.net/oauth2",
        "DashboardRedirectURIs": [
            "https://vpn.mahamid.net/nb-auth",
            "https://vpn.mahamid.net/nb-silent-auth"
        ]
    }
}
